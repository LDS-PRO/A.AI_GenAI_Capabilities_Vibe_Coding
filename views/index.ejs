<!DOCTYPE html>
<html lang="en">
  <head>
    <title>MS SQL Writeback</title>
    <!-- Favicon -->
    <link id="favicon" rel="icon" href="https://glitch.com/edit/favicon-app.ico" type="image/x-icon">
    
    <!-- Meta tags for proper rendering and SEO -->
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    
    <!-- Bootstrap 5.3.6 - Latest version as of 2024 -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.6/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-4Q6Gf2aSP4eDXB8Miphtr37CMZZQ5oXLH2yaXMJ2w8e2ZtHTl7GptT4jmndRuHDT" crossorigin="anonymous">
    
    <!-- jQuery 3.7.1 - Latest version as of 2024 -->
    <script src="https://code.jquery.com/jquery-3.7.1.min.js" integrity="sha256-/JqT3SQfawRcv/BIHPThkBvs0OEvtFFmqPF/lYI/Cxo=" crossorigin="anonymous"></script>
    
    <!-- Tableau Extensions API - Latest version -->
    <script src="https://cdn.jsdelivr.net/gh/tableau/extensions-api@master/lib/tableau.extensions.1.latest.js"></script>
    
    <!-- Our custom JavaScript file -->
    <script src="./index.js" defer></script>
  </head>
  <body>
    <div class="container" style="margin: 30px;">
      <div class="row">
        <div class="col">
          <div class="form-group">
            <!-- Label for accessibility -->
            <label for="clustervalueid" class="form-label">Enter new cluster value:</label>
            <!-- Input field for cluster value -->
            <textarea class="form-control" placeholder="Enter new cluster value" id="clustervalueid" name="clustervalue" rows="1"></textarea>
          </div>
        </div>
        <div class="col-auto">
          <!-- Update button that calls updateRequest with server-provided values -->
          <button type="submit" class="btn btn-primary" onclick="updateRequest(<%= cluster %>,<%= PC %>)">Update</button>
        </div>
      </div>
    </div>
  </body>
</html>

  